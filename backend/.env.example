# Настройки БД (совпадают с корневым .env)
DB_USER=philatelist_user
DB_PASSWORD=super_secret_local_password_123
DB_NAME=philatelist_db
DB_HOST=localhost
DB_PORT=5432

# Секретный ключ для JWT (сгенерируй свой через python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ключи hCaptcha (пока оставим заглушки)
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000